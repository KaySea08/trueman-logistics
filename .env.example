NODE_ENV=development
WEB_PORT=5173
API_PORT=3000
POSTGRES_DB=trueman_logistics
POSTGRES_USER=trueman_app
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql://trueman_app:change_this_local_password@postgres:5432/trueman_logistics?schema=public
REDIS_URL=redis://redis:6379
WEB_ORIGIN=http://localhost:5173

# Phase 3 identity and authentication secrets. Generate fresh values for your own environment.
AUTH_PEPPER=replace_with_at_least_32_random_characters
MFA_ENCRYPTION_KEY=replace_with_64_hex_characters

# Local email testing: Mailpit is provided by Docker Compose.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Trueman Logistics <no-reply@trueman.local>

# Optional customer service channels. Use international format.
# VITE_SUPPORT_PHONE=+86YOURCHINAPHONENUMBER
# VITE_SUPPORT_WHATSAPP=86YOURWHATSAPPNUMBERWITHOUTPLUS

# Only set these temporarily when running the one-time bootstrap-admin command.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=use_a_unique_14_character_or_longer_password
# BOOTSTRAP_ADMIN_NAME=Primary Administrator
# BOOTSTRAP_ADMIN_EMPLOYEE_CODE=TRU-0001

# Optional SMS verification through Twilio (phone verification remains unavailable until configured).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
