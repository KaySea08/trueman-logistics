{
  "name": "@trueman/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "prisma generate && nest start --watch",
    "start:quote-worker": "nest build && node dist/quotes/quote-worker.js",
    "start:quote-worker:prod": "node dist/quotes/quote-worker.js",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "test:quotes": "tsx --test src/quotes/quotes.service.spec.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:admin": "tsx scripts/bootstrap-admin.ts",
    "db:grant-quote-officer": "tsx scripts/grant-quote-officer.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "nodemailer": "^6.9.16",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/node": "^22.10.2",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/express": "^4.17.21",
    "tsx": "^4.19.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
